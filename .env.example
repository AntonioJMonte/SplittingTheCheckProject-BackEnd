# Servidor
NODE_ENV=development
PORT=3333

# Banco de dados (fora do Docker; dentro do compose o host é "postgres")
DATABASE_URL=postgresql://splittr:splittr@localhost:5432/splittr_db?schema=public

# Testes de integração (npm run test:integration); precisa usar o schema integration_test
# DATABASE_URL_INTEGRATION=postgresql://splittr:splittr@localhost:5432/splittr_db?schema=integration_test

# Origens permitidas no CORS (HTTP e WebSocket), separadas por vírgula. Precisa listar a origem
# exata do frontend — protocolo, host e porta. O coringa "*" não vale: o cookie de refresh exige
# credenciais e o navegador recusa "*" nesse caso.
CORS_ORIGIN=http://localhost:5173

# Quantos proxies ficam entre o cliente e a API (D-108). 0 em desenvolvimento; 1 no Azure Container Apps,
# cujo ingress acrescenta o IP do cliente ao X-Forwarded-For. O IP resolvido é o que o rate limit conta:
# 0 atrás de um proxy faz todos os usuários dividirem um limite só; um número maior que o real deixa o
# cliente forjar o próprio IP. Confira no log "incoming request": o remoteAddress deve ser o IP do cliente.
TRUST_PROXY_HOPS=0

# Redis (fora do Docker; dentro do compose o host é "redis")
REDIS_URL=redis://localhost:6379

# JWT (mínimo de 32 caracteres cada)
JWT_SECRET=troque-este-valor-por-um-segredo-com-32-caracteres-ou-mais
JWT_REFRESH_SECRET=troque-este-outro-valor-por-um-segredo-com-32-caracteres
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Anthropic (opcional). Sem chave, a categorização usa só regras e cache e cai em "Outros".
ANTHROPIC_API_KEY=

# Nível de log do pino: fatal | error | warn | info | debug | trace | silent
# Em NODE_ENV=test o nível é forçado para silent.
LOG_LEVEL=info
